      "options": {
        "mode": "html",
        "content": "<div style=\"font-family:Inter,Roboto,'Segoe UI',system-ui,sans-serif\"><div style=\"font-size:28px;font-weight:700;line-height:1.2\">4. Performance et continuité</div><div style=\"font-size:17px;opacity:.85;margin-top:4px\">En haut, en direct : <b style='color:#fb923c'>orange</b> = paiements validés pas encore écrits en base ; <b style='color:#60a5fa'>bleu</b> = paiements pas encore lus par le service ; lignes violettes = étapes de l'essai. En bas : chaque essai publié face à sa propre limite (trait rouge).</div></div>"
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Paiements en attente (en direct)",
      "description": "Paiements validés pas encore écrits en base. La courbe monte pendant l'interruption, puis redescend à 0 quand la nouvelle version a rattrapé son retard. Sources : compteurs de la plateforme (toutes les 2 s) et groupe Kafka (chaque seconde).",
      "datasource": {
        "type": "influxdb",
        "uid": "simulpix-influxdb"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 97
      },
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "simulpix-influxdb"
          },
          "query": "from(bucket: \"simulpix_observability\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => (r._measurement == \"sujet11_compteurs\" and r._field == \"ecart_topic_base\") or (r._measurement == \"sujet11_groupe\" and r._field == \"lag\"))\n  |> map(fn: (r) => ({_time: r._time, _value: float(v: r._value), serie: if r._measurement == \"sujet11_groupe\" then \"lag\" else \"ecart\"}))\n  |> group(columns: [\"serie\"])\n  |> aggregateWindow(every: v.windowPeriod, fn: max, createEmpty: false)\n  |> pivot(rowKey: [\"_time\"], columnKey: [\"serie\"], valueColumn: \"_value\")",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "noValue": "Non disponible",
          "custom": {
            "lineInterpolation": "linear",
            "lineWidth": 3,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false,
            "axisLabel": "",
            "axisSoftMin": 0
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "ecart"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "pas encore écrits en base (paiements)"
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#fb923c"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "lag"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "pas encore lus par le service (paiements)"
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#60a5fa"
                }
              }
            ]
